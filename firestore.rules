        && amenToggle(resource.data, request.resource.data);
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create, delete: if false;
        allow update: if request.auth != null && activeAccount(request.auth.uid) && member(request.auth.uid)
          && amenToggle(resource.data, request.resource.data);
      }
    }
    match /users/{uid} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && activeAccount(uid) && (validProfile(request.resource.data) || validLegacyProfile(request.resource.data));
      allow delete: if false;
      match /walk/progress {
        allow read: if owner(uid);
        allow create: if owner(uid) && activeAccount(uid) && validProgress();
        allow update: if owner(uid) && activeAccount(uid) && validProgress();
        allow delete: if false;
      }
      match /walk/saved {
        allow read: if owner(uid);
        allow create: if owner(uid) && activeAccount(uid) && validSaved({});
        allow update: if owner(uid) && activeAccount(uid) && validSaved(resource.data.verses);
        allow delete: if false;
      }
      match /attempts/{document} { allow read: if owner(uid); allow write: if false; }
      match /resumes/{document} { allow read: if owner(uid); allow write: if false; }
      match /readingResumes/{document} { allow read: if owner(uid); allow write: if false; }
      match /saved/{document} { allow read: if owner(uid); allow write: if false; }
      // Who he blocked and what he reported: his alone.
      match /social/{document} {
        allow read: if owner(uid);
        allow create, update: if owner(uid) && activeAccount(uid) && document == 'hidden'
          && request.resource.data.keys().hasOnly(['users','posts'])
          && request.resource.data.get('users', []) is list && request.resource.data.get('users', []).size() <= 500
          && request.resource.data.get('posts', []) is list && request.resource.data.get('posts', []).size() <= 2000;
        allow delete: if false;
      }
      match /private/{document} {
        allow read: if owner(uid) && document in ['journey','savedCatalog','editionAccess','entitlement'];
        allow write: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
