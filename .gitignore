# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Deployment caches and private signing credentials
node_modules/
.firebase/
.env*
*.p8
*.p12
*.mobileprovision
config/private/

# Reproducible authenticated-web output; build with tool/build_web.py
/public/app/

# Python caches
__pycache__/

# Abandoned CocoaPods installs and editor-agent scratch
/ios/Pods.incomplete-*/
/.github/modernize/

# Emulator and CLI debug output
firebase-debug*.log
firestore-debug*.log
ui-debug*.log
